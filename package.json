{
  "name": "colortile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:cleanup": "node --env-file=.env.local scripts/cleanup-leaderboards.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test:unit": "tsc -p unit-testing/tsconfig.json && cd unit-testing/.compiled && node --test",
    "test:database": "tsc -p unit-testing/tsconfig.json && cd unit-testing/.compiled && node --env-file=../../.env.test.local --test unit-testing/leaderboard-database.test.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.6.23",
    "howler": "^2.2.4",
    "motion": "^12.40.0",
    "next": "15.5.21",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-confetti": "^6.4.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@types/howler": "^2.2.13",
    "@types/node": "22.15.30",
    "@types/pg": "^8.20.0",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "autoprefixer": "10.4.21",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.5.10",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
