{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./.compiled",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "../app/game/game-logic.ts",
    "../app/game/leaderboard.ts",
    "../app/game/game-types.ts",
    "../app/game/confetti-logic.ts",
    "../app/game/gradient-quality.ts",
    "../app/game/personal-best.ts",
    "../app/game/win-sequence.ts",
    "../app/lib/cookies.ts",
    "./**/*.ts"
  ],
  "exclude": [
    "./.compiled",
    "../node_modules"
  ]
}
